{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "rootDir": "..",
    "outDir": "../dist-electron",
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../src/types.ts"],
  "exclude": ["./**/*.test.ts"]
}
